# Test Environment Variables
NODE_ENV=test
SANDBOX_MODE=true
ALLOW_PROD_WRITES=false
SKIP_CRITICAL_SECRETS_CHECK=true

# Database Configuration (for docker-compose.test-runner.yml)
POSTGRES_HOST=postgres-test
POSTGRES_PORT=5432
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpass
POSTGRES_DB=testdb

# Redis Configuration
REDIS_HOST=redis-test
REDIS_QUEUE_HOST=redis-test
REDIS_PASSWORD=

# Security
ENABLE_RATE_LIMIT=false

# Authentication (JWT)
JWT_ACCESS_SECRET="test_access_secret"
JWT_REFRESH_SECRET="test_refresh_secret"

# SMS Provider
SMS_PROVIDER=mock

# Storage Provider
STORAGE_PROVIDER=local

# Server Configuration
PORT=3000

# App URLs
DATABASE_URL="postgresql://testuser:testpass@postgres-test:5432/testdb?schema=public"
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379
SESSION_SECRET=test_session_secret_min_32_chars_long
JWT_ACCESS_SECRET=test_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=test_refresh_secret_min_32_chars_long
