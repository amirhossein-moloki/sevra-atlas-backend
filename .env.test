# Test Environment Variables
NODE_ENV=test
SANDBOX_MODE=true
ALLOW_PROD_WRITES=false
SKIP_CRITICAL_SECRETS_CHECK=true

# Database Configuration (for docker-compose.test-runner.yml)
POSTGRES_HOST=postgres-test
POSTGRES_PORT=5432
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpass
POSTGRES_DB=testdb

# Redis Configuration
REDIS_HOST=redis-test
REDIS_QUEUE_HOST=redis-test
REDIS_PASSWORD=

# Security
ENABLE_RATE_LIMIT=false

# Authentication (JWT)
JWT_ACCESS_SECRET="test_access_secret"
JWT_REFRESH_SECRET="test_refresh_secret"

# SMS Provider
SMS_PROVIDER=mock

# Storage Provider
STORAGE_PROVIDER=local
STORAGE_UPLOAD_DIR=uploads_test

# Server Configuration
PORT=3000

# Session & Admin
SESSION_SECRET="test_session_secret"
ADMIN_COOKIE_PASSWORD="test_cookie_password"
ADMIN_SESSION_SECRET="test_admin_session_secret"

# App URLs
DATABASE_URL="postgresql://testuser:testpass@localhost:5432/testdb?schema=public"
REDIS_URL="redis://localhost:6379"
