# Stage 1: Build
FROM node:20-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    openssl \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma/

# Using npm ci for clean, predictable installs
RUN npm ci

COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Build TypeScript
RUN npm run build

# Copy seeder datasets and other script assets to dist
RUN mkdir -p dist/scripts/seeder/datasets && cp -r scripts/seeder/datasets/* dist/scripts/seeder/datasets/
RUN cp scripts/*.json dist/scripts/ 2>/dev/null || true

# Remove development dependencies
RUN npm prune --production


# Stage 2: Runtime
FROM node:20-slim AS runtime

WORKDIR /app

# Install curl and runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy only necessary files from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/scripts ./scripts

# Create and set permissions for uploads directory
RUN mkdir -p uploads && chown -R node:node /app/uploads

# Ensure the app directory is owned by node
RUN chown -R node:node /app

USER node

EXPOSE 3000

ENV NODE_ENV=production
ENV IS_WORKER=false

# Healthcheck to ensure the API is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/v1/health || exit 1

CMD ["node", "dist/src/server.js"]
