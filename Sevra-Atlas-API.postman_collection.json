  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level Pre-request scripts",
          "pm.request.headers.add({key: 'Accept', value: 'application/json'});",
          "if (!pm.request.headers.has('Content-Type') && pm.request.body) {",
          "    pm.request.headers.add({key: 'Content-Type', value: 'application/json'});",
          "}",
          "",
          "// Helper to generate unique identifiers",
          "const timestamp = Date.now();",
          "pm.collectionVariables.set('uniqueSuffix', timestamp);",
          "pm.collectionVariables.set('testEmail', `test_user_${timestamp}@example.com`);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level Test helpers",
          "utils = {",
          "    assertSuccess: function(status = 200) {",
          "        pm.test(`Status code is ${status}`, () => {",
          "            pm.response.to.have.status(status);",
          "        });",
          "        pm.test('Response success is true', () => {",
          "            const json = pm.response.json();",
          "            pm.expect(json.success).to.be.true;",
          "        });",
          "    },",
          "    assertError: function(status, code) {",
          "        pm.test(`Status code is ${status}`, () => {",
          "            pm.response.to.have.status(status);",
          "        });",
          "        pm.test(`Error code is ${code}`, () => {",
          "            const json = pm.response.json();",
          "            pm.expect(json.error.code).to.eql(code);",
          "        });",
          "    },",
          "    validateSchema: function(schema) {",
          "        pm.test('Schema is valid', () => {",
          "            pm.response.to.have.jsonSchema(schema);",
          "        });",
          "    },",
          "    saveToEnv: function(jsonPath, envVar) {",
          "        const json = pm.response.json();",
          "        const value = _.get(json, jsonPath);",
          "        if (value !== undefined) {",
          "            pm.environment.set(envVar, value);",
          "            console.log(`Saved ${value} to environment variable ${envVar}`);",
          "        }",
          "    },",
          "    schemas: {",
          "        User: {",
          "            type: 'object',",
          "            properties: {",
          "                id: { type: ['string', 'number'] },",
          "                phoneNumber: { type: 'string' },",
          "                role: { type: 'string' }",
          "            },",
          "            required: ['id', 'phoneNumber', 'role']",
          "        },",
          "        Salon: {",
          "            type: 'object',",
          "            properties: {",
          "                id: { type: ['string', 'number'] },",
          "                name: { type: 'string' },",
          "                slug: { type: 'string' }",
          "            },",
          "            required: ['id', 'name', 'slug']",
          "        }",
          "    }",
          "};"
        ]
      }
    }
  ],
